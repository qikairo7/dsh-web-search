{
  "name": "@qikairo7/dsh-web-search",
  "version": "0.10.0",
  "private": true,
  "description": "Free-tier-first multi-backend web search and fetch providers for DeepSeek Harness",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "dsh",
    "web-search",
    "web-fetch",
    "anysearch",
    "tavily",
    "firecrawl",
    "zhihu"
  ],
  "homepage": "https://github.com/qikairo7/dsh-web-search#readme",
  "bugs": {
    "url": "https://github.com/qikairo7/dsh-web-search/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qikairo7/dsh-web-search.git"
  },
  "license": "MIT",
  "author": "qikairo7",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "test": "node --test",
    "docs:check": "node scripts/verify-docs.mjs",
    "check": "node scripts/check-syntax.mjs && node scripts/verify-docs.mjs && node --test",
    "benchmark": "node --env-file-if-exists=.env scripts/public-benchmark.mjs",
    "benchmark:refresh": "node scripts/refresh-benchmark-fixture.mjs",
    "benchmark:preflight": "node --env-file-if-exists=.env scripts/public-benchmark.mjs --preflight",
    "check:syntax": "node scripts/check-syntax.mjs",
    "quality:probe": "node --env-file-if-exists=.env scripts/quality-probe.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.5-alpha.1 <5",
    "@deepseek-ai/dsh-credentials": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/dsh-web": "*"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": ">=3.18.1-rc.1 <4"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-credentials": "0.2.2-rc.3",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.3",
    "@deepseek-ai/dsh-web": "0.2.2-rc.3"
  }
}
